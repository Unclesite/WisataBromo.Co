{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "Data reservasi paket wisata Bromo oleh wisatawan",
      "type": "object",
      "properties": {
        "bookingCode": {
          "type": "string",
          "description": "Kode unik pemesanan (contoh: WB-261001-1234)",
          "maxLength": 64
        },
        "tripDate": {
          "type": "string",
          "description": "Tanggal keberangkatan trip (YYYY-MM-DD)",
          "maxLength": 32
        },
        "fullName": {
          "type": "string",
          "description": "Nama lengkap pemesan/tamu",
          "maxLength": 150
        },
        "whatsappNumber": {
          "type": "string",
          "description": "Nomor WhatsApp aktif pemesan",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "description": "Alamat email pemesan untuk pengiriman e-tiket dan invoice",
          "maxLength": 150
        },
        "packageTitle": {
          "type": "string",
          "description": "Nama paket wisata yang dipilih",
          "maxLength": 200
        },
        "packageId": {
          "type": "string",
          "description": "ID paket wisata",
          "maxLength": 100
        },
        "paxCount": {
          "type": "number",
          "description": "Jumlah peserta domestik"
        },
        "wnaCount": {
          "type": "number",
          "description": "Jumlah peserta mancanegara (WNA)"
        },
        "pickupAddress": {
          "type": "string",
          "description": "Alamat / lokasi penjemputan",
          "maxLength": 500
        },
        "paymentMethod": {
          "type": "string",
          "description": "Metode pembayaran (bca, dana, ovo)",
          "maxLength": 50
        },
        "paymentProofName": {
          "type": "string",
          "description": "Nama file bukti transfer DP",
          "maxLength": 255
        },
        "paymentProofDataUrl": {
          "type": "string",
          "description": "Data URL / link bukti transfer",
          "maxLength": 2000000
        },
        "grandTotal": {
          "type": "number",
          "description": "Total estimasi biaya trip dalam Rupiah"
        },
        "downPayment": {
          "type": "number",
          "description": "Nominal DP 30% dalam Rupiah"
        },
        "specialNotes": {
          "type": "string",
          "description": "Catatan khusus dari pemesan",
          "maxLength": 1000
        },
        "includeDocumentation": {
          "type": "boolean",
          "description": "Apakah menyertakan add-on dokumentasi foto/video DSLR"
        },
        "includeDrone": {
          "type": "boolean",
          "description": "Apakah menyertakan add-on video drone 4K"
        },
        "status": {
          "type": "string",
          "description": "Status reservasi",
          "enum": ["WAITING_DP", "DP_SUBMITTED", "VERIFIED", "CANCELLED"],
          "maxLength": 50
        },
        "driveLink": {
          "type": "string",
          "description": "Tautan Google Drive untuk bukti transfer",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu pembuatan reservasi",
          "maxLength": 100
        }
      },
      "required": [
        "bookingCode",
        "tripDate",
        "fullName",
        "whatsappNumber",
        "email",
        "packageTitle",
        "paxCount",
        "pickupAddress",
        "grandTotal",
        "downPayment",
        "status"
      ]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Koleksi data seluruh reservasi dan bukti pembayaran pelanggan WisataBromo.co"
    }
  }
}
